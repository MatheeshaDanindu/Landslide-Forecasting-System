# Data (never commit — large rasters, sensitive ACCIMT dataset)
data/*

# Trained model weights
models/*

# Raw geodata, wherever it lands
*.kml
*.kmz
*.tif
*.tiff
*.nc
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx

# Model weights, wherever they land (not just under models/)
*.pt
*.pth
*.h5
*.ckpt
*.onnx

# Credentials
.env

# Local experiment tracking
mlruns/

# Run logs -- regenerated every run, not meant to be versioned (the CSVs/JSON
# under experiments/ that actually hold results are not excluded)
experiments/**/*.log

# Python
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/

# OS
.DS_Store
Thumbs.db
